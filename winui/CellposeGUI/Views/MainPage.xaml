<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="CellposeGUI.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:CellposeGUI.Views"
    xmlns:rendering="using:CellposeGUI.Rendering"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid RowDefinitions="Auto,*">
        <MenuBar Grid.Row="0">
            <MenuBarItem Title="File">
                <MenuFlyoutItem x:Name="LoadImageItem" Text="Load image (*.tif, *.png, *.jpg)" />
                <MenuFlyoutItem x:Name="LoadFolderItem" Text="Load folder with pattern..." />
                <MenuFlyoutSubItem Text="Options">
                    <ToggleMenuFlyoutItem x:Name="AutoloadMasksItem" Text="Autoload masks from _masks.tif file" />
                    <ToggleMenuFlyoutItem x:Name="DisableAutosaveItem" Text="Disable autosave _seg.npy file" />
                </MenuFlyoutSubItem>
                <MenuFlyoutItem x:Name="LoadMasksItem" Text="Load masks (*.tif, *.png, *.jpg)" />
                <MenuFlyoutItem x:Name="LoadSegItem" Text="Load processed/labelled image (*_seg.npy)" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="SaveSegItem" Text="Save masks and image (as *_seg.npy)" />
                <MenuFlyoutItem x:Name="ExportMasksItem" Text="Save masks as PNG/tif" />
                <MenuFlyoutItem x:Name="ExportOutlinesItem" Text="Save outlines as text for ImageJ" />
                <MenuFlyoutItem x:Name="ExportROIsItem" Text="Save outlines as .zip archive of ROI files for ImageJ" />
                <MenuFlyoutItem x:Name="ExportFlowsItem" Text="Save flows and cellprob as tif" />
            </MenuBarItem>
            <MenuBarItem Title="Edit">
                <MenuFlyoutItem x:Name="UndoItem" Text="Undo previous mask/trace" IsEnabled="False" />
                <MenuFlyoutItem x:Name="UndoRemoveItem" Text="Undo remove mask" IsEnabled="False" />
                <MenuFlyoutItem x:Name="ClearMasksItem" Text="Clear all masks" />
                <MenuFlyoutItem Text="Remove selected cell (Ctrl+Click)" IsEnabled="False" />
                <MenuFlyoutItem Text="FYI: Merge cells by Alt+Click" IsEnabled="False" />
            </MenuBarItem>
            <MenuBarItem Title="Models">
                <MenuFlyoutItem x:Name="AddModelItem" Text="Add custom torch model to GUI" />
                <MenuFlyoutItem x:Name="RemoveModelItem" Text="Remove selected custom model from GUI" />
                <MenuFlyoutItem x:Name="TrainModelItem" Text="Train new model with image+masks in folder" />
            </MenuBarItem>
        </MenuBar>

        <Grid Grid.Row="1" ColumnDefinitions="320,*,380">
            <local:LeftSidebarView x:Name="LeftSidebar" Grid.Column="0" HorizontalAlignment="Stretch" />
            <Grid Grid.Column="1" RowDefinitions="*,Auto">
                <rendering:ImageCanvasControl x:Name="Canvas" Grid.Row="0" />
                <Grid Grid.Row="1" Padding="12,6" Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ProgressBar x:Name="StatusProgress" Grid.Column="1" Width="120" Margin="12,0" Maximum="1" />
                    <TextBlock x:Name="CellCountText" Grid.Column="2" Margin="12,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="ZoomText" Grid.Column="3" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Grid>
            <local:RightSidebarView x:Name="RightSidebar" Grid.Column="2" HorizontalAlignment="Stretch" />
        </Grid>
    </Grid>
</Page>
